# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# First-run admin seed credentials (used only by `npm run db:seed`)
ADMIN_EMAIL="virginia@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Βιργινία Πανάκη"

# Random secret for hashing session tokens (min 32 chars recommended)
SESSION_SECRET="replace-with-a-long-random-secret"

# Media storage backend: "database" (default, Vercel-safe) | "local"
MEDIA_STORAGE="database"

# Optional absolute path when MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR="/var/data/uploads"

# Public site URL (used for metadata / canonicals)
NEXT_PUBLIC_SITE_URL="https://your-domain.gr"
